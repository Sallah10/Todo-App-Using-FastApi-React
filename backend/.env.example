# Copy to backend/.env and adjust. Read by pydantic-settings.

# SQLite by default. Swap for Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/todos
DATABASE_URL=sqlite:///./todos.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
